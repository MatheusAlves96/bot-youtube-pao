# =====================================================
# DISCORD - CONFIGURAÇÃO DO BOT
# =====================================================
# ⚠️ IMPORTANTE: Use o BOT TOKEN (não é Client ID nem Client Secret!)
#
# Como obter:
# 1. Acesse: https://discord.com/developers/applications
# 2. Selecione sua aplicação
# 3. Vá na aba "Bot" (não "OAuth2"!)
# 4. Clique em "Reset Token" ou "Copy Token"
# 5. Cole o token abaixo
#
# Formato do token: MTIzNDU2Nzg5MDEyMzQ1Njc4OQ.GhIjKl.MnOpQrStUvWxYz
DISCORD_TOKEN=seu_bot_token_aqui

# Prefixo dos comandos (padrão: .)
COMMAND_PREFIX=.

# =====================================================
# 🤖 GROQ API (IA para Autoplay Inteligente)
# =====================================================
# Obtenha sua chave GRATUITA em: https://console.groq.com
#
# A IA analisa a música atual e histórico para gerar queries
# otimizadas que trazem músicas relacionadas mas diversas
#
# Benefícios:
# - Queries contextuais inteligentes
# - Evita loops e repetições
# - Detecta gênero, mood, artistas similares
# - Funciona sem IA (fallback automático)
#
# Rate Limits GRATUITOS:
# - 30 requests/minuto
# - 14.400 requests/dia
# - Mais que suficiente para autoplay!
#
# Deixe em branco para usar sistema manual (também funciona bem)
GROQ_API_KEY=

# Seu ID de usuário do Discord (opcional, mas recomendado)
# Como obter:
# 1. No Discord: Configurações > Avançado > Ative "Modo Desenvolvedor"
# 2. Clique direito no SEU perfil/avatar (em qualquer lugar)
# 3. Clique em "Copiar ID"
# 4. Cole o ID abaixo (apenas números, 17-19 dígitos)
# Formato: 123456789012345678
OWNER_ID=seu_id_discord_aqui

# Canal dedicado para comandos de música (opcional)
# Se definido, o bot só responderá comandos neste canal específico
# Deixe em branco para aceitar comandos em qualquer canal
# Como obter:
# 1. Ative "Modo Desenvolvedor" no Discord
# 2. Clique direito no canal desejado
# 3. Clique em "Copiar ID"
# Formato: 123456789012345678
MUSIC_CHANNEL_ID=

# =====================================================
# YOUTUBE - AUTENTICAÇÃO
# =====================================================
# Escolha UMA das duas opções abaixo:

# --- OPÇÃO 1: API Key (Mais simples, com limitações) ---
# Como obter:
# 1. Acesse: https://console.cloud.google.com/
# 2. Crie um projeto
# 3. Ative "YouTube Data API v3"
# 4. Vá em "Credenciais" > "Criar Credenciais" > "Chave de API"
# 5. Cole a chave abaixo
YOUTUBE_API_KEY=sua_api_key_aqui

# --- OPÇÃO 2: OAuth2 (Recomendado, mais funcionalidades) ---
# Como obter:
# 1. No Google Cloud Console, vá em "Credenciais"
# 2. "Criar credenciais" > "ID do cliente OAuth 2.0"
# 3. Tipo: "Aplicativo para computador"
# 4. Baixe o arquivo JSON e coloque em config/credentials.json
# 5. Cole as credenciais abaixo (ou deixe em branco se usar o arquivo JSON)
YOUTUBE_CLIENT_ID=seu_client_id_aqui
YOUTUBE_CLIENT_SECRET=seu_client_secret_aqui

# Caminhos das credenciais OAuth2
CREDENTIALS_PATH=config/credentials.json
TOKEN_PATH=config/token.json

# =====================================================
# CONFIGURAÇÕES DO PLAYER
# =====================================================
MAX_QUEUE_SIZE=100
DEFAULT_VOLUME=0.5
TIMEOUT_SECONDS=300

# =====================================================
# AUTOPLAY - REPRODUÇÃO CONTÍNUA AUTOMÁTICA
# =====================================================
# Ativa/desativa autoplay por padrão ao iniciar o bot
# true = ativo | false = desativado (padrão)
# Usuários podem alterar com o comando .autoplay on/off
AUTOPLAY_ENABLED=false

# Quantidade de músicas a adicionar por vez quando a fila está pequena
# Recomendado: 2-3 músicas para manter o fluxo natural
# Padrão: 2
AUTOPLAY_QUEUE_SIZE=2

# Tamanho do histórico (evita repetir músicas da sessão)
# Quanto maior, menos repetição, mas mais memória usada
# Padrão: 100 músicas
AUTOPLAY_HISTORY_SIZE=100

# Duração mínima de músicas para autoplay (em minutos)
# Filtra vídeos muito curtos (shorts, TikToks, clipes de 30s)
# Recomendado: 1-2 minutos
# Padrão: 1 minuto
AUTOPLAY_MIN_DURATION=1

# Duração máxima de músicas para autoplay (em minutos)
# Filtra vídeos muito longos (playlists, lives, sets de DJ)
# Para heavy metal/rock progressivo: 15-20 minutos
# Para pop/eletrônica: 8-10 minutos
# Padrão: 15 minutos
AUTOPLAY_MAX_DURATION=15

# =====================================================
# CROSSFADE - TRANSIÇÃO SUAVE ENTRE MÚSICAS
# =====================================================
# Ativa/desativa crossfade por padrão (fade in/out entre músicas)
# true = ativo (transições suaves) | false = desativado
# Usuários podem alterar com o comando .crossfade on/off
# Padrão: true
CROSSFADE_ENABLED=true

# Duração do fade in/out em segundos
# Quanto maior, mais suave e lenta a transição
# Recomendado: 5-15 segundos
# Padrão: 10 segundos
CROSSFADE_DURATION=10

# Qualidade do crossfade (número de steps para interpolação)
# Controla a suavidade da transição de volume
# Mais steps = transição mais suave e natural, mas usa mais CPU
# Presets recomendados:
#   - 20 steps = Qualidade baixa (CPU mínima, transições perceptíveis)
#   - 35 steps = Qualidade média (balanceado)
#   - 50 steps = Qualidade alta (profissional, imperceptível)
# Padrão: 50 (qualidade máxima)
CROSSFADE_STEPS=50

# Qualidade de Áudio
AUDIO_FORMAT=bestaudio/best
BITRATE=192

# Logging
# Nível de log do bot (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG = Máximo detalhamento (recomendado para desenvolvimento)
# INFO = Informações gerais de operação (recomendado para produção)
# Padrão: INFO
LOG_LEVEL=INFO

# Arquivo de log principal do bot
# Registra todas as operações do bot (músicas, comandos, erros)
# Padrão: bot.log
LOG_FILE=bot.log

# NOTA: O autoplay possui log dedicado em logs/autoplay.log
# Registra automaticamente:
#   - Sessões de autoplay (vídeo base, estratégia, query gerada)
#   - Resultado da API do YouTube (quantidade de resultados)
#   - Batch processing (velocidade, economia de quota)
#   - Filtros de duração (aprovados/rejeitados por vídeo)
#   - Validação IA (decisões por vídeo, confiança, razão)
#   - Vídeos adicionados à fila
#   - Tempo total e sucesso/falha da sessão

# Cache
CACHE_ENABLED=True
CACHE_DIR=cache
CACHE_MAX_SIZE_MB=500

# Tamanho do cache LRU de vídeos (quantos vídeos armazenar em memória)
# Usado para evitar re-extrair informações de vídeos já processados
# Quanto maior, mais memória usa, mas menos chamadas ao yt-dlp
# Recomendado: 100-500
# Padrão: 100
VIDEO_CACHE_SIZE=100

# Features
ENABLE_PLAYLISTS=True
ENABLE_FILTERS=True
ENABLE_LYRICS=False

# =====================================================
# RIOT GAMES API (OPCIONAL - Plugin League of Legends)
# =====================================================
# Obtenha gratuitamente em: https://developer.riotgames.com/
#
# Como obter:
# 1. Faça login com sua conta Riot/LoL
# 2. No dashboard, clique em "REGENERATE API KEY"
# 3. Copie a chave (formato: RGAPI-xxxxxxxx...)
# 4. Cole abaixo
#
# ⚠️ ATENÇÃO:
# - Development Key expira em 24 horas
# - Para uso prolongado, aplique para Production Key
# - Deixe em branco se não usar o plugin LoL
#
# Formato: RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RIOT_API_KEY=

# =====================================================
# 🍪 COOKIES DO YOUTUBE (EVITA BLOQUEIO DE BOT)
# =====================================================
# Alguns vídeos do YouTube bloqueiam bots com "Sign in to confirm you're not a bot"
# Use cookies do navegador para contornar isso
#
# Como obter cookies.txt:
# 1. Instale extensão: https://chrome.google.com/webstore/detail/get-cookiestxt-locally/cclelndahbckbenkjhflpdbgdldlbecc
# 2. Faça login no YouTube no navegador
# 3. Clique na extensão e exporte cookies.txt
# 4. Coloque o arquivo na raiz do bot (mesmo diretório do main.py)
# 5. Especifique o caminho abaixo
#
# Renovação: A cada 30-90 dias quando os cookies expirarem
# Segurança: Nunca compartilhe cookies.txt (contém suas credenciais!)
#
# Padrão: cookies.txt (raiz do projeto)
YTDL_COOKIES_PATH=cookies.txt
